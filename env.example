# Подключается автоматически через Railway Variable Reference: ${{Postgres.DATABASE_URL}}
DATABASE_URL=

# Секрет для подписи JWT-токенов — задайте сложное случайное значение
JWT_SECRET=change-me-to-a-random-secret-string

# Глобальный служебный бот. Группы уведомлений НЕ задаются через env —
# каждая компания указывает свои в карточке филиала / настройках (мульти-тенант).
BOT_TOKEN=

# Eskiz.uz — SMS-провайдер (notify.eskiz.uz)
ESKIZ_EMAIL=your@email.com
ESKIZ_PASSWORD=your_eskiz_password
# Имя отправителя: 4546 для тестов, для прода нужно купить/одобрить своё имя
ESKIZ_FROM=4546
